# ---- Crustdata (required for live runs) -------------------------------------
# Paste the key from app.crustdata.com -> API Keys
CRUSTDATA_API_KEY=
CRUSTDATA_BASE_URL=https://api.crustdata.com
CRUSTDATA_API_VERSION=2025-11-01

# ---- Investigation agent (optional) -----------------------------------------
# Without this the investigation step falls back to the deterministic
# rule-based disconfirmation engine. The pipeline NEVER silently fabricates.
# Free key: aistudio.google.com -> Get API key
GEMINI_API_KEY=
PRAHARI_LLM_MODEL=gemini-3.5-flash-lite

# ---- Watcher webhook receiver ------------------------------------------------
# Shown in the POST /watch/company response. Used to verify
# x-crustdata-signature: t=<unix>,v1=<hex>
CRUSTDATA_WEBHOOK_SECRET=
PRAHARI_WEBHOOK_TOLERANCE_SECONDS=300

# ---- Local paths -------------------------------------------------------------
PRAHARI_DB=./prahari.db
PRAHARI_CONFIG=./config.yaml
